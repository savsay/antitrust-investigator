{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/competition-agent/finding-v1.2.schema.json",
  "title": "Rekabet risk bulgusu v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "finding_type",
    "jurisdictions",
    "control_ids",
    "summary",
    "priority",
    "evidence",
    "legal_references",
    "missing_facts",
    "alternative_explanations",
    "human_review_required",
    "next_action",
    "versions"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "finding_type": {
      "enum": [
        "risk_signal",
        "insufficient_context",
        "no_signal_in_excerpt",
        "access_restricted"
      ]
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "Acil",
        "Yüksek",
        "Orta",
        "Düşük",
        "İncelenemedi"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "quote",
          "start_char",
          "end_char",
          "location"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "start_char": {
            "type": "integer",
            "minimum": 0
          },
          "end_char": {
            "type": "integer",
            "minimum": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "description": "Alıntının özgün dili (ör. tr, en, ru)"
          },
          "translation": {
            "type": "string",
            "description": "Alıntının çevirisi; kanıt özgün dildeki quote alanıdır"
          },
          "role": {
            "enum": [
              "supporting",
              "counter"
            ],
            "description": "counter: bulguya karşı kanıt (ör. ret cevabı); yoksa destekleyici"
          }
        }
      }
    },
    "legal_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "section",
          "version"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "missing_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review_required": {
      "type": "boolean"
    },
    "next_action": {
      "type": "string"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "prompt",
        "rules",
        "corpus"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "rules": {
          "type": "string"
        },
        "corpus": {
          "type": "string"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "description": "Öncelikten ayrı üç eksen; ihlal olasılığı yüzdesi değildir",
      "properties": {
        "impact": {
          "enum": [
            "Yüksek",
            "Orta",
            "Düşük"
          ],
          "description": "Olası etki"
        },
        "urgency": {
          "enum": [
            "Yüksek",
            "Orta",
            "Düşük"
          ],
          "description": "Süren ihale, zam veya delil kaybı riski"
        },
        "evidence_sufficiency": {
          "enum": [
            "Yüksek",
            "Orta",
            "Düşük"
          ],
          "description": "Kanıtın yeterliliği"
        }
      }
    },
    "parallel_exposure": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rekabet hukuku dışındaki paralel riskler (ör. TR-15 kamu ihalesi yasaklama, TR-16 TCK m.235)"
    },
    "escalation_route": {
      "type": "string",
      "description": "Bulgunun yönlendirileceği bağımsız hat (ör. Hukuk, Denetim Komitesi); ilgili kişinin yönetim hattı olamaz"
    },
    "data_screens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Bulguyu destekleyen ihale_analiz.py uyarı kimlikleri (ör. U-001)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Bulgunun başlığı; claims ile aynı yönde olmalı (vaka.py denetler)"
    },
    "area": {
      "enum": [
        "rekabet",
        "komsu"
      ],
      "description": "rekabet: rekabet hukuku göstergesi; komsu: güvenlik, erişim gibi komşu alan, rekabet ihlali diye adlandırılmaz"
    },
    "claims": {
      "type": "array",
      "description": "Kim, kime, neyi, hangi eylemle; teklif/ret/kabul ayrımı burada korunur",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kim",
          "eylem",
          "neyi",
          "kanit"
        ],
        "properties": {
          "kim": {
            "type": "string",
            "minLength": 1
          },
          "eylem": {
            "enum": [
              "teklif",
              "ret",
              "kabul",
              "uygulama",
              "bilgi_paylasimi",
              "talimat",
              "silme",
              "engelleme",
              "sapma",
              "karar",
              "taahhut",
              "sozlesme"
            ]
          },
          "neyi": {
            "type": "string",
            "minLength": 1
          },
          "kime": {
            "type": "string"
          },
          "kanit": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "evidence içindeki kanıt kimlikleri (K1…)"
          },
          "belirsiz": {
            "type": "boolean",
            "description": "Yorum ya da örtülü dil hipotezine dayanıyor"
          },
          "kosul": {
            "type": "string",
            "description": "Koşullu kabulün koşulu"
          },
          "aktaran": {
            "type": "string",
            "description": "Olayı aktaran kişi (dolaylı anlatım)"
          },
          "ret_aciklamasi": {
            "type": "string"
          }
        }
      }
    },
    "coded_language": {
      "type": "array",
      "description": "Bulgunun dayandığı örtülü dil hipotezleri; hipotez kanıt değildir",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phrase",
          "hypothesis",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phrase": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "finding_type": {
            "const": "risk_signal"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "legal_references": {
            "minItems": 1
          },
          "human_review_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "finding_type": {
            "const": "access_restricted"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "maxItems": 0
          },
          "priority": {
            "const": "İncelenemedi"
          },
          "human_review_required": {
            "const": true
          }
        }
      }
    }
  ],
  "description": "v1 ve v1.1 ile geriye dönük uyumludur: zorunlu alanlar değişmedi; v1.1 assessment, parallel_exposure, escalation_route, data_screens ekledi; v1.2 title, area, claims, coded_language ve kanıtta role ekler (vaka.py çıktısı)."
}